// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  moduleFormat    = "cjs"
}
datasource db {
  provider = "mysql"
}

enum SaleType {
  In_shop
  Mobile
  Web
}

enum SUPPLIER_TYPE {
  INDIVIDUAL
  BUSINESSS
}

enum Gender {
  Male
  Female
  Unknown
}

enum AuthProvider {
  Web
  Google
  Mobile
  In_Shop
}

enum ChannelType {
  BANK_TRANSFER
  MOBILE_MONEY
}

enum WithdrawStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL //withdraw
  TRANSFER
  SALE_PAYMENT //for payments received from sales, projects, events, etc.
  REFUND //for sale refunds and supply payment refunds
}

enum InventoryRecordCategory {
  Restock
  Depletion
  Transfer
  Adjustment
  Manufacturing
}

enum StockTransferStatus {
  Confirmed
  Pending
  Rejected
}

enum SaleStatus {
  PENDING
  FAILED
  IN_DELIVERY
  PACKAGING
  CANCELLED
  SUCCESSFUL
}

enum PaymentType {
  CASH
  CHEQUE
  MOBILE_MONEY
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SUPPLIES
  MAINTENANCE
  TRANSPORT
  INSURANCE
  MARKETING
  TRAINING
  TAXES
  MEDICAL_SUPPLIES
  OFFICE_SUPPLIES
  EQUIPMENT_PURCHASE
  EQUIPMENT_REPAIR
  CLEANING
  SECURITY
  INTERNET
  WATER
  ELECTRICITY
  COMMUNICATION
  SOFTWARE_SUBSCRIPTIONS
  MISCELLANEOUS
}

enum PaymentStatus {
  FULLY_PAID
  PARTIALLY_PAID
  UNPAID
}
model Company {
  id          String   @id @default(uuid())
  name        String
  email       String
  tel1        String
  tel2        String?
  address     String
  logo        String?
  website     String?
  tinNumber   String?
  description String?
  foundedYear Int?
  industry    String?
  employees   String?
  workHours   Float?   @default(8.0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([name])
}
model Branch {
  id        String   @id @default(uuid())
  name      String
  location  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Store         Store[]
  // branchExpense branchExpense[]

  @@index([name, location])
  @@map("branches")
  employees Employee[]
  branchExpenses branchExpense[]
}

model Store {
  id                  String     @id @default(uuid())
  name                String
  branchId            String
  isForSales          Boolean    @default(false)
  isForAppSales       Boolean    @default(false)
  branch              Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  authorizedPersonnel Json? // Consider normalizing if frequently queried

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relations
  // ProductInventory     ProductInventory[]
  // Sales                Sale[]
  // fromInventoryRecords InventoryRecord[]  @relation("FromStore")
  // toInventoryRecords   InventoryRecord[]  @relation("ToStore")
  // Supply               Supply[]

  @@index([branchId])
  @@index([name])
  @@map("stores") // Explicit table name
  fromInventoryRecords InventoryRecord[]  @relation("FromStore")
  toInventoryRecords   InventoryRecord[]  @relation("ToStore")
  productInventories ProductInventory[]
  sales Sale[]
  supplies Supply[]
}
model Unit {
  id        String   @id @default(uuid())
  name      String
  value     Float?
  abr       String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Item             Item[]

  @@unique([name])
  @@map("units")
  inventoryRecords InventoryRecord[]
  productInventories ProductInventory[]
  supplies Supply[]
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  Item      Item[]
}
model ItemCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  Item Item[]

  @@map("item_categories")
}

model Batch {
  id String @id @default(uuid())
  number String
  expiryDate DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
model Item {
  id              String        @id @default(uuid())
  categoryId      String
  category        ItemCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId         String
  brand           Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  barcodeType     String?
  alertStockLevel Float
  description     String      @db.Text
  showInPos       Boolean       @default(false)
  name            String
  buyingPrice     Decimal       @db.Decimal(10, 2)
  sellingPrice    Decimal       @db.Decimal(10, 2)
  wholeSalePrice    Decimal       @db.Decimal(10, 2) @default(0.0)
  barcode         String?
  unitId          String
  unit            Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  image           String
  sideEffects     Json?
  variation       Json? // strengths of the medicine if any, e.g., 500mg, 250mg, etc.
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())

  @@index([categoryId])
  @@index([name])
  @@index([barcode])
  @@index([createdAt])
  @@map("items")
  inventoryRecords InventoryRecord[]
  productInventories ProductInventory[]
  supplies Supply[]
}

model ProductInventory {
  id        String   @id @default(uuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storeId   String
  qty       Float
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([itemId, storeId, unitId])
  @@index([storeId, itemId])
  @@index([qty])
  @@map("product_inventory")
}

// Inventory records with optimized date queries
model InventoryRecord {
  id       String                  @id @default(uuid())
  category InventoryRecordCategory
  itemId   String
  item     Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation("FromStore", fields: [storeId], references: [id], onDelete: Cascade)

  toStoreId String?
  toStore   Store?  @relation("ToStore", fields: [toStoreId], references: [id], onDelete: Cascade)

  initiatedQty      Float?
  qty               Float
  remainingQuantity Float?
  unitId            String
  unit              Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  source            String
  description       String?
  recordedBy        String
  employee          Employee            @relation(fields: [recordedBy], references: [id], onDelete: Cascade)
  transferId        String?
  transferStatus    StockTransferStatus @default(Confirmed)
  isResolved        Boolean?
  resolveNotes      String?
  images            Json?
  extraNote         String?
  expectedOutput    Float?
  recordedOutput    Float?
  updatedAt         DateTime            @updatedAt
  createdAt         DateTime            @default(now())

  @@index([storeId, createdAt])
  @@index([itemId, createdAt])
  @@index([category, createdAt])
  @@index([recordedBy, createdAt])
  @@map("inventory_records")
}

model Client {
  id              String    @id @default(uuid())
  provider        AuthProvider
  firstName       String
  lastName        String
  fullName        String
  gender          Gender?
  phone           String? 
  email           String  @unique
  address         String?
  password        String
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())
  addresses Address[]
  // Sales              Sale[]
  // ClientPrescription ClientPrescription[]
  // ClientOtp          ClientOtp[]
  // ItemReview         ItemReview[]

  @@index([firstName, lastName])
  @@index([phone])
  @@index([createdAt])
  @@map("clients")
  inquiries Inquiry[]
  clientOtps ClientOtp[]
  sales Sale[]
}

model ClientOtp {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@map("client_otps")
}
model Address {
  id              String    @id @default(uuid())
  clientId String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label String?
  town String
  village String
  landmark String?
  isDefault Boolean @default(false)
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())
}

//finance models
model WithdrawChannel {
  id                      String    @id @default(uuid())
  type                    ChannelType
  name                    String
  phoneNumber             String?
  bank                    String?
  accountNumber           String?
  isVerified              Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  ChannelVerificationCode ChannelVerificationCode[]
  TransactionHistory      TransactionHistory[]
  WithdrawHistory         WithdrawHistory[]
}

model ChannelVerificationCode {
  id         String    @id @default(uuid())
  channelId String
  channel   WithdrawChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  createdAt DateTime        @default(now())

  @@index([channelId, createdAt])
}

model Wallet {
  id               String    @id @default(uuid())
  name            String
  purpose         String?
  balance         Decimal           @default(0) @db.Decimal(10, 2)
  createdAt       DateTime          @default(now())
  isForSales      Boolean           @default(false)
  isForAppSales   Boolean           @default(false)
  isForWebSales   Boolean           @default(false)
  canBeDeleted    Boolean           @default(false)
  updatedAt       DateTime          @updatedAt
  Withdraw        Withdraw[]
  WithdrawHistory WithdrawHistory[]
}

model Withdraw {
  id         String    @id @default(uuid())
  amount    Decimal        @db.Decimal(10, 2)
  walletId  String
  wallet    Wallet         @relation(fields: [walletId], references: [id])
  status    WithdrawStatus
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}
model WithdrawHistory {
  id                        String    @id @default(uuid())
  amount                   Decimal         @db.Decimal(10, 2)
  walletId                 String
  wallet                   Wallet          @relation(fields: [walletId], references: [id])
  channelId                String
  channel                  WithdrawChannel @relation(fields: [channelId], references: [id])
  description              String?         @db.Text
  reference                String          @unique
  status                   WithdrawStatus
  transaction_completed_at DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}
model TransactionHistory {
  id              String    @id @default(uuid())
  type            TransactionType
  amount          Decimal         @db.Decimal(10, 2)
  channelId       String
  channel         WithdrawChannel @relation(fields: [channelId], references: [id])
  status          WithdrawStatus
  description     String?         @db.Text
  reference       String          @unique
  phoneNumber     String?
  transactionId   String          @unique
  provider        String?
  currency        String
  statusUpdatedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

//support
enum InquiryStatus {
  PENDING
  SOLVED
}
model Inquiry {
  id              String    @id @default(uuid())
  clientId String
  client         Client @relation(fields: [clientId], references: [id])
  subject String @db.Text
  message String @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  inquiryResponses InquiryResponse[]
}

model InquiryResponse {
  id              String    @id @default(uuid())
  inquiryId String
  inquiry         Inquiry @relation(fields: [inquiryId], references: [id])
  employeeId String //--the person responding
  subject String @db.Text
  message String @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

//hr
model Employee {
  id                    String      @id @default(uuid())
  firstName             String
  lastName              String
  gender                Gender
  email                 String      @unique
  tel                   String      @unique
  password              String
  branchId              String
  branch                Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  hasAccess             Boolean     @default(false)
  isActive              Boolean     @default(true)
  updatedAt             DateTime    @updatedAt
  createdAt             DateTime    @default(now())

  // Relations
  //EmailVerification             EmailVerification[]
  //Sales                         Sale[]
  // EmployeeLoginLogs             EmployeeLoginLogs[]
  // Supply                        Supply[]
  // SupplyPayments                SupplyPayments[]
  // SalePaymentTransactionHistory SalePaymentTransactionHistory[]

  @@index([email, isActive])
  @@index([createdAt])
  @@map("employees")
  inventoryRecords InventoryRecord[]
  branchExpenses branchExpense[]
  salePayments SalePayment[]
  sales Sale[]
  supplyPayments SupplyPayments[]
  supplies Supply[]
}

model branchExpense {
  id           String          @id @default(uuid())
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category     ExpenseCategory
  title        String
  description  String?
  receiptImage String?
  amount       Float
  dateIncurred DateTime
  recordedBy   String
  employee     Employee        @relation(fields: [recordedBy], references: [id], onDelete: Cascade)
  updatedAt    DateTime        @updatedAt
  createdAt    DateTime        @default(now())

  @@index([branchId, dateIncurred])
  @@map("branch_expenses")
}


//sale
model Sale {
  id             String         @id @default(uuid())
  type           SaleType       @default(In_shop)
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items          Json // Array of CartItemDto - consider normalized table for large systems
  servedBy       String?
  employee       Employee?      @relation(fields: [servedBy], references: [id], onDelete: Cascade)
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleStatus     SaleStatus     @default(PENDING)
  salePaymentId   String @unique
  salePayment    SalePayment         @relation(fields: [salePaymentId], references: [id], onDelete: Cascade)
  status         PaymentStatus @default(FULLY_PAID)
  total          Decimal        @db.Decimal(10, 2)
  paymentMethod   String
  notes          String?
  updatedAt      DateTime       @updatedAt
  createdAt      DateTime       @default(now())
  timeLine       SaleTimeLine[]

  // Comprehensive indexing for fast queries
  @@index([storeId, createdAt])
  @@index([servedBy, createdAt])
  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([createdAt]) // For date range queries
  @@index([total])
  @@map("sales")
}

model SaleTimeLine {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  state     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
model SalePayment {
  id String @id @default(uuid())

  // Transaction identification
  transaction_uuid        String?  @unique
  transaction_reference   String?  @unique
  provider_transaction_id String? @unique

  // Amount information
  amount           Decimal @db.Decimal(10, 2)
  amount_formatted String?
  currency         String  @default("UGX")

  // Payment provider details
  provider       String? // "mtn", "airtel", "card payments"
  provider_mode  String? // "mtnuganda", "airteluganda", "card paymentsuganda"
  phone_number   String?

  // Transaction status
  status     WithdrawStatus @default(PENDING)
  event_type String? // "collection.completed", "collection.failed"

  // Description and notes
  description String? @db.Text
  notes       String? @db.Text

  // Cashier/employee info
  cashierId String?
  employee  Employee? @relation(fields: [cashierId], references: [id], onDelete: Cascade)

  // Webhook tracking
  webhook_received_at DateTime @default(now())
  webhook_payload     Json? // Store raw webhook payload for debugging

  // Timestamps
  transaction_initiated_at DateTime? // From webhook created_at
  transaction_completed_at DateTime? // From webhook updated_at
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  // Indexes for better query performance
  @@index([transaction_uuid])
  @@index([transaction_reference])
  @@index([provider_transaction_id])
  @@index([provider])
  @@index([phone_number])
  @@index([created_at])
  @@map("sale_payment_transaction_history")
  sales Sale[]
}

//supplier
model Supplier {
  id        String        @id @default(uuid())
  firstName String
  lastName  String
  email     String?       @unique
  contact   String        @unique
  address   String?
  type      SUPPLIER_TYPE @default(INDIVIDUAL)
  updatedAt DateTime      @updatedAt
  createdAt DateTime      @default(now())
  Supply    Supply[]

  @@index([firstName, lastName])
  @@index([contact])
  @@index([createdAt])
}

model Supply {
  id                 String             @id @default(uuid())
  itemId             String
  item               Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplierId         String
  supplier           Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  qty                Float
  unitId             String
  uom                Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  value              Decimal            @db.Decimal(10, 2)
  balance            Decimal            @db.Decimal(10, 2)
  recievedBy         String
  employee           Employee           @relation(fields: [recievedBy], references: [id], onDelete: Cascade)
  paymentStatus      PaymentStatus @default(UNPAID)
  proofImage         String?
  destinationStoreId String
  destinationStore   Store              @relation(fields: [destinationStoreId], references: [id], onDelete: Cascade)
  updatedAt          DateTime           @updatedAt
  createdAt          DateTime           @default(now())
  SupplyPayments     SupplyPayments[]

  @@index([supplierId])
  @@index([createdAt])
}

model SupplyPayments {
  id                String             @id @default(uuid())
  supplyId          String
  supply            Supply             @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  bank              String?
  chequeNumber      String?
  chequeBankingDate DateTime?
  paymentType       PaymentType
  barterItemName    String?
  amount            Decimal            @db.Decimal(10, 2)
  paidBy            String
  employee          Employee           @relation(fields: [paidBy], references: [id], onDelete: Cascade)
  paymentStatus     PaymentStatus
  proofImage        String?
  updatedAt         DateTime           @updatedAt
  createdAt         DateTime           @default(now())
}
