<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Quotation – Ocare Pharmacy</title>
</head>

<body
    style="margin:0; padding:0; background-color:#f4f6f9; color:#333; font-family: 'Segoe UI', Arial, sans-serif; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;">
    <div
        style="max-width:600px; margin:40px auto; background-color:#ffffff; padding:30px; border-radius:10px; box-shadow:0 4px 15px rgba(0,0,0,0.1);">

        <!-- Header -->
        <div style="text-align:center; padding-bottom:20px; border-bottom:2px solid #e6e9ef;">
            <h1 style="margin:0; font-size:26px; font-weight:700; color:#1ca24e;">
                Ocare Pharmacy
            </h1>
            <p style="margin:4px 0 0; color:#777; font-size:14px;">Quotation</p>
        </div>

        <!-- Body (generic) -->
        <div style="font-size:16px; line-height:1.6; color:#333; padding-top:20px;">
            <p>Please find below our quotation for the items you requested.</p>

            <p><strong>Quotation #:</strong> {{quotationNumber}}<br />
                <strong>Date:</strong> {{quotationDate}}<br />
                <strong>Valid Until:</strong> {{validUntil}}
            </p>

            <!-- Order Summary Table -->
            <table style="width:100%; border-collapse:collapse; margin:16px 0;">
                <thead>
                    <tr style="background-color:#f4f6f9;">
                        <th style="padding:10px; text-align:left; border-bottom:2px solid #e6e9ef;">Item</th>
                        <th style="padding:10px; text-align:center; border-bottom:2px solid #e6e9ef;">Qty</th>
                        <th style="padding:10px; text-align:right; border-bottom:2px solid #e6e9ef;">Unit Price</th>
                        <th style="padding:10px; text-align:right; border-bottom:2px solid #e6e9ef;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each lineItems}}
                    <tr>
                        <td style="padding:8px 10px; border-bottom:1px solid #e6e9ef;">{{this.name}}</td>
                        <td style="padding:8px 10px; text-align:center; border-bottom:1px solid #e6e9ef;">
                            {{this.quantity}}
                        </td>
                        <td style="padding:8px 10px; text-align:right; border-bottom:1px solid #e6e9ef;">
                            {{this.unitPrice}}
                        </td>
                        <td style="padding:8px 10px; text-align:right; border-bottom:1px solid #e6e9ef;">
                            {{this.totalPrice}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
                <tfoot>
                    {{#if discount}}
                    <tr>
                        <td colspan="3" style="padding:8px 10px; text-align:right; border-bottom:1px solid #e6e9ef;">
                            Discount
                        </td>
                        <td style="padding:8px 10px; text-align:right; border-bottom:1px solid #e6e9ef;">
                            {{discount}}
                        </td>
                    </tr>
                    {{/if}}
                    <tr>
                        <td colspan="3" style="padding:10px; text-align:right; font-weight:bold;">Grand Total:</td>
                        <td style="padding:10px; text-align:right; font-weight:bold; color:#1ca24e;">
                            {{grandTotal}}
                        </td>
                    </tr>
                </tfoot>
            </table>

            <p><strong>Terms &amp; Conditions:</strong><br />
                {{#if terms}}
                {{terms}}
                {{else}}
                This quotation is valid for 14 days from the date of issue. Prices are subject to change without notice.
                {{/if}}
            </p>

            <p>If you wish to proceed, please reply to this email or contact us at
                <a href="mailto:sales@ocareug.com" style="color:#1ca24e; text-decoration:none;">
                    sales@ocareug.com
                </a>.
                We will arrange the order and delivery accordingly.
            </p>

            <p>We look forward to serving you.</p>
        </div>

        <!-- Footer -->
        <div
            style="margin-top:40px; font-size:12px; color:#777; text-align:center; border-top:1px solid #e6e9ef; padding-top:20px;">
            &copy; {{year}} Ocare Pharmacy · All rights reserved<br />
            <a href="https://ocareug.com" style="color:#1ca24e; text-decoration:none;">www.ocareug.com</a><br />
            <span style="font-size:11px;">This is a system‑generated quotation. No signature is required.</span>
        </div>
    </div>
</body>

</html>